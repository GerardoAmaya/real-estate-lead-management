# ---------------------------------------------------------------------------
# Copiar a .env en la raiz del proyecto: cp .env.example .env
# El backend lee este archivo en desarrollo; en Docker las variables entran
# por env_file del compose. Nunca versionar el .env real.
# ---------------------------------------------------------------------------

# Entorno de ejecucion
NODE_ENV=development

# Servidor
PORT=3000

# Base de datos
# Desde el host (npm run dev) usar localhost; dentro de Docker el compose
# sobrescribe este valor apuntando al servicio "mongo".
MONGODB_URI=mongodb://localhost:27017/real_estate_leads
MONGODB_DB_NAME=real_estate_leads

# Credenciales de Mongo en Docker (solo desarrollo local)
MONGO_PORT=27017

# Autenticacion
# Generar uno propio con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Usuario inicial creado por el seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# CORS: origenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:4200

# Rate limiting global (15 minutos, 100 peticiones)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Rate limiting del login: mas estricto, solo cuenta intentos fallidos
# (5 minutos, 7 intentos)
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=7

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
