{
  "name": "real-estate-lead-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de seguimiento de leads inmobiliarios",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",

    "migrate:up": "migrate-mongo up -f migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.js",
    "migrate:create": "migrate-mongo create -f migrate-mongo-config.js",

    "seed": "tsx ../seed/seed.ts",
    "seed:fresh": "tsx ../seed/seed.ts --fresh",

    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --coverage --runInBand",

    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^10.2.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
